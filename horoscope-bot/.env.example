# Gemini API Key (for embeddings & fallback)
GEMINI_API_KEY=your_gemini_key_here

# MiMo 2.5 Pro API Key (Xiaomi Token Plan) — DEFAULT MODEL
MIMO_API_KEY=your_mimo_key_here

# DeepSeek API Key (optional, fallback model)
# DEEPSEEK_API_KEY=your_deepseek_key_here

# Default model: mimo | gemini | deepseek
READING_MODEL=mimo
